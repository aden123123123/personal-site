---
import { getEntry, render } from 'astro:content';
import ProsePageLayout from '../layouts/ProsePageLayout.astro';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('找不到 about.md');
const { Content } = await render(page);
---

<ProsePageLayout title={page.data.title} description={page.data.description} eyebrow="About · 关于" icon="👋">
	<Content />
</ProsePageLayout>
