---
import FormattedDate from '../components/FormattedDate.astro';
import PageHeader from '../components/PageHeader.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
	title: string;
	description: string;
	eyebrow: string;
	updatedDate?: Date;
	icon?: string;
}
const { title, description, eyebrow, updatedDate, icon } = Astro.props;
---

<SiteLayout title={title} description={description}>
	<article class="simple-page">
		<PageHeader {eyebrow} {title} {description} {icon} />
		{updatedDate && <p class="updated">最近更新：<FormattedDate date={updatedDate} /></p>}
		<div class="prose"><slot /></div>
	</article>
</SiteLayout>

<style>
	.simple-page { max-width: var(--reading-width); margin-inline: auto; }
	.updated { margin: -1.75rem 0 2rem; color: var(--muted-light); font-size: 0.72rem; }
</style>
