---
import FormattedDate from './FormattedDate.astro';

interface Item {
	href: string;
	title: string;
	description: string;
	date: Date;
	label?: string;
}
interface Props { items: Item[]; icon?: string }
const { items, icon = '📄' } = Astro.props;
---

<ol class="content-list">
	{items.map((item) => (
		<li>
			<a href={item.href}>
				<span class="item-icon" aria-hidden="true">{icon}</span>
				<div class="item-copy">
					<h2>{item.title}</h2>
					<p>{item.description}</p>
				</div>
				<div class="item-meta">
					{item.label && <span>{item.label}</span>}
					<FormattedDate date={item.date} />
				</div>
			</a>
		</li>
	))}
</ol>

<style>
	.content-list { margin: 0; padding: 0; list-style: none; }
	.content-list li { border-bottom: 1px solid var(--line); }
	.content-list li:first-child { border-top: 1px solid var(--line); }
	.content-list a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: start;
		gap: 0.8rem;
		padding: 0.85rem 0.2rem;
		color: inherit;
		text-decoration: none;
	}
	.item-icon { padding-top: 0.08rem; font-size: 1.05rem; }
	.item-copy h2 { margin: 0; font-size: 1rem; font-weight: 560; }
	.item-copy p { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.82rem; line-height: 1.55; }
	.item-meta { display: flex; align-items: flex-end; flex-direction: column; gap: 0.2rem; color: var(--muted-light); font-size: 0.7rem; white-space: nowrap; }
	.item-meta span { color: var(--muted); }
	.content-list a:hover { background: var(--paper-deep); }
	.content-list a:hover h2 { text-decoration: underline; text-decoration-color: rgba(44, 44, 43, 0.35); text-underline-offset: 0.2em; }
	@media (max-width: 620px) {
		.content-list a { grid-template-columns: auto minmax(0, 1fr); }
		.item-meta { grid-column: 2; align-items: flex-start; flex-direction: row; gap: 0.65rem; }
	}
</style>
